// Bug 2.27: @vbmcompilechunk's output cannot be @include'd in the same
// compile that generates it. Same root cause as 2.10's @bin2inc finding:
// Parser::HandleVBMCompileChunk (PASS_FIRST) writes its output file
// before Parser::PreprocessIncludeFiles (PASS_PRE) resolves @include,
// but the generated file still isn't found on a clean build.
// Method B (compile-time only, no VICE step): expect COMPILE_ERROR
// ("Could not open file for inclusion") pre-fix, exit 0 post-fix.
program Bug_2_27_VbmCompileChunkIncludeSameCompile;

@vbmcompilechunk "sample_sprite.flf" "2_27_vbmcompilechunk_generated.inc" "DrawChunk227" "myPtr227" "" 0 4 4 0
@include "2_27_vbmcompilechunk_generated.inc"

begin
	loop();
end.
