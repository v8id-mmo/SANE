Program Bug_2_76_LongNegativeLiteralTruncated;
// Bug 2.76 (FIXED 2026-07-30): a negative decimal literal wider than 16
// bits (magnitude >= 65536) was truncated to a 16-bit magnitude before it
// ever reached codegen, silently storing the wrong value. Root cause:
// Parser::Factor()'s unary-minus handling (parser.cpp) hardcodes a
// two-tier two's-complement negation (`256 - x` for x<256, `65536 - x`
// otherwise) with no 24-bit tier at all, so any magnitude >= 65536 wrapped
// at 16 bits instead of 24. Fixed by adding the missing tier
// (`16777216 - x` for x>=65536), matching the same 24-bit width `long`
// uses everywhere else in this fork's codegen.
//
// -100000's correct 24-bit two's complement is $FE7960; lv1/lv3 below
// check the round trip on two values spanning the 16-bit boundary, since
// the exact wrong value observed pre-fix ($86A0, i.e. -100000 mod 65536)
// pinpointed a 16-bit-wide truncation step specifically.
//
// lv2 (-1) is deliberately NOT compared against a raw "-1" literal
// (unlike lv1/lv3): doing so hits a separate, previously-uncatalogued bug
// (2.81, found while fixing this one, deferred - see BUGS_PROGRESS.md) -
// a small-magnitude negative literal (using the untouched 8-bit tier
// above) isn't sign-extended when its upper bytes are read for a wider
// `long` comparison, so `if (lv2 = -1)` compares lv2's real $FFFFFF
// against a wrongly zero-extended $0000FF and fails regardless of
// whether lv2 itself was stored correctly. Comparing against a
// runtime-computed `zero - one` instead (a register subtraction, not a
// compile-time literal comparison) isolates this snippet to 2.76's own
// fix, same technique already used by 2.35/2.75's own regressions for an
// analogous reason.
@use "unittests/common"

var
	lv1 : long = -100000;
	lv2 : long = -1;
	lv3 : long = -70000;
	zero : long = 0;
	one : long = 1;

begin
	disableciainterrupts();
	preventirq();
	setmemoryconfig(1,0,0);
	Common::TestInit();

	Vars::text := "2.76a";
	if (lv1 = -100000) then Common::PASS() else Common::FAIL();
	Vars::text := "2.76b";
	if (lv2 = (zero - one)) then Common::PASS() else Common::FAIL();
	Vars::text := "2.76c";
	if (lv3 = -70000) then Common::PASS() else Common::FAIL();

	@addmonitorcommand "command 1  \"save \\\"$DIR/results.bin\\\" 0 8000 8000  ; quit \"  "
	addbreakpoint();
	moveto(5,24,04);
	if (peek(^$8000,0)=0) then
		printstring("PASS",0,40)
	else
		printstring("FAIL",0,40);
	loop();
end.
