Program Bug_2_40_CopyImageColorData_InvalidBank;
// Bug 2.40: CopyImageColorData's bank parameter is only meaningful as 1,
// 2, or 3. Methods6502::CopyImageColorData (methods6502.cpp ~6067-6073)
// maps it with `if(bank==1) ... else if(bank==2) ... else if(bank==3) ...`
// and no matching else clause; any other value (0, or >=4) silently
// falls through and behaves exactly like bank 0, no error or warning.
//
// Inverted expectation, same shape as 2.25/2.59: KNOWN_BUGS.md's only
// suggested fix is a compile-time error ("bank must be 1, 2, or 3"), not
// a runtime correction, so a fixed compiler would REJECT this file rather
// than produce a differently-addressed .prg. Pre-fix: COMPILE_OK (bank=5
// compiles clean today, confirmed live - no error text at all). Post-fix:
// should become COMPILE_ERROR once the missing else branch is added. No
// VICE step either way - a pure compile-time check, not a register value.
var
	source : ^byte;

begin
	source := $3000;
	copyimagecolordata(source, 5); // bank=5, outside the documented 1-3 range
	loop();
end.
