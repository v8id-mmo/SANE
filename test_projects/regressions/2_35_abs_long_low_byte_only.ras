Program Bug_2_35_AbsLongLowByteOnly;
// Bug 2.35: `abs()` on a `long` value only negates the low byte.
// Methods6502::Abs (methods6502.cpp ~3790-3834) branches only on
// isWord() (true = 16-bit integer path, false = plain byte path); `long`
// never satisfies isWord() so it falls into the byte path, which checks
// bit 7 of the low byte alone and negates only that byte, leaving the
// middle/high bytes untouched.
//
// -100000 as a 24-bit two's-complement value is $FE7960 (low byte $60,
// mid $79, high $FE, bit 7 of the high byte set). Correct abs() = 100000
// ($0186A0). Buggy: only the low byte gets two's-complemented, middle/
// high bytes pass through unchanged.
//
// lv is built at runtime (0 - poslv) rather than from a negative decimal
// literal directly: a separate, uncatalogued bug truncates a `long`
// variable's negative decimal-literal initializer to a 16-bit magnitude
// before it ever reaches codegen (confirmed 2026-07-29 while fixing this
// bug; `lv : long = -100000;` stores garbage - see BUGS_PROGRESS.md's
// newly-found entry). Building the value via runtime subtraction instead
// isolates this snippet to Abs()'s own bug, independent of that other one.
@use "unittests/common"

var
	zero : long = 0;
	poslv : long = 100000;
	lv : long;
	r : long;

begin
	disableciainterrupts();
	preventirq();
	setmemoryconfig(1,0,0);
	Common::TestInit();

	lv := zero - poslv;
	r := abs(lv);

	Vars::text := "2.35";
	if (r = 100000) then Common::PASS() else Common::FAIL();

	@addmonitorcommand "command 1  \"save \\\"$DIR/results.bin\\\" 0 8000 8000  ; quit \"  "
	addbreakpoint();
	moveto(5,24,04);
	if (peek(^$8000,0)=0) then
		printstring("PASS",0,40)
	else
		printstring("FAIL",0,40);
	loop();
end.
