Program Bug_2_66_AddressVarUnusable;
// Bug 2.66 FIXED (2026-07-30): a non-`const` `address` variable was
// completely unusable. `CodeGen6502::LoadVariable` (codegen_6502.cpp
// ~1965-1985) routes any TokenType::ADDRESS symbol through the same
// compile-time-constant byte-blob path as STRING/CSTRING/INCBIN
// (CodeGen6502::LoadByteArray). A `const ... : address = $NNNN`
// declaration fits that shape (the "data" is just the one address
// value, substituted like a label), but a plain `var` declaration has no
// backing blob and no compile-time constant index to look up, so codegen
// used to fail with the confusing "Could not find variable 'ADDRESS'."
//
// Fix direction taken: the smaller/safer of the two KNOWN_BUGS.md
// offered - reject a non-const `address` at parse time with a clear
// message (`Parser::TypeSpec`, parser.cpp), rather than giving `address`
// real 2-byte mutable storage. Same shape/precedent as 2.15/2.16/2.24:
// this stays permanently COMPILE_ERROR either way, so this snippet's
// outcome is unchanged by the fix (no .prg produced, nothing to run
// through VICE) - only the error message and the point at which it fires
// changed, from an obscure codegen-time failure to a clear parse-time
// one naming the actual constraint. The assignment/read/Poke usage below
// is deliberately left in place: it documents what a non-const `address`
// still cannot do, matching a real, working `const address` at
// docs-examples/address.ras.
@use "unittests/common"

var
	y : address;
	readBack : byte;

begin
	disableciainterrupts();
	preventirq();
	setmemoryconfig(1,0,0);
	Common::TestInit();

	y := $D020;
	Poke(y, 6, 0);
	readBack := Peek(y, 0);

	Vars::text := "2.66";
	if (readBack = 6) then Common::PASS() else Common::FAIL();

	@addmonitorcommand "command 1  \"save \\\"$DIR/results.bin\\\" 0 8000 8000  ; quit \"  "
	addbreakpoint();
	moveto(5,24,04);
	if (peek(^$8000,0)=0) then
		printstring("PASS",0,40)
	else
		printstring("FAIL",0,40);
	loop();
end.
