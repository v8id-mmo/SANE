Program Bug_2_67_WholeRecordAssignmentFails;
// Bug 2.67: whole-record assignment (`b := a;`, no field selector on
// either side) always fails to compile with "Cannot assign a record of
// type '<name>' to a single variable", for any record or class type.
// `AbstractCodeGen::AssignVariable` calls
// `AbstractCodeGen::ValidateAssignStatement` first, which unconditionally
// rejects any RHS that resolves to a record type, before the function
// ever reaches its own `AbstractCodeGen::AssignPureRecords` branch a few
// dozen lines further down - a real, working field-by-field copy
// implementation that already exists but is unreachable dead code, since
// the earlier validation always throws first.
//
// Same shape as bug 2.53/2.66: this is a compile-time failure, not a
// wrong-runtime-value bug, so pre-fix this snippet is expected to be
// COMPILE_ERROR (no .prg produced, nothing to run through VICE). Once
// `ValidateAssignStatement`'s blanket rejection is narrowed enough to
// actually reach `AssignPureRecords`, the whole-record assignment below
// should compile and copy both fields correctly.
@use "unittests/common"

var
	Point = record
		x, y : byte;
	end;

	a, b : Point;

begin
	disableciainterrupts();
	preventirq();
	setmemoryconfig(1,0,0);
	Common::TestInit();

	a.x := 10;
	a.y := 20;
	b.x := 0;
	b.y := 0;

	b := a;

	Vars::text := "2.67";
	if ((b.x = 10) and (b.y = 20)) then Common::PASS() else Common::FAIL();

	@addmonitorcommand "command 1  \"save \\\"$DIR/results.bin\\\" 0 8000 8000  ; quit \"  "
	addbreakpoint();
	moveto(5,24,04);
	if (peek(^$8000,0)=0) then
		printstring("PASS",0,40)
	else
		printstring("FAIL",0,40);
	loop();
end.
