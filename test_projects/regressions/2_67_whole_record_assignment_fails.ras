Program Bug_2_67_WholeRecordAssignmentFails;
// Bug 2.67 FIXED (2026-07-30): whole-record assignment (`b := a;`, no
// field selector on either side) always failed to compile with "Cannot
// assign a record of type '<name>' to a single variable", for a plain
// `record`. `AbstractCodeGen::AssignVariable` calls
// `AbstractCodeGen::ValidateAssignStatement` first, which unconditionally
// rejected any RHS that resolves to a record type, before the function
// ever reached its own `AbstractCodeGen::AssignPureRecords` branch a few
// dozen lines further down - a real, working field-by-field copy
// implementation that already existed but was unreachable dead code,
// since the earlier validation always threw first.
//
// Correction: this entry originally (inaccurately) claimed the same
// failure applied "for any record or class type" - it doesn't. A `class`
// right-hand side was never blocked by this check (it already required
// the RHS NOT be a class to fire at all) both before and after this fix;
// see bug 2.80 (`2_80_class_assignment_silent_noop.ras`) for what a
// `class` actually does instead (silently compiles to a no-op, a
// separate, still-open bug).
//
// Fixed by narrowing `ValidateAssignStatement`'s rejection to exempt the
// exact case `AssignPureRecords` already handles (left-hand side also a
// plain, non-class record of matching type), so this snippet now PASSes
// (was COMPILE_ERROR pre-fix): `b := a;` compiles and copies both fields.
@use "unittests/common"

var
	Point = record
		x, y : byte;
	end;

	a, b : Point;

begin
	disableciainterrupts();
	preventirq();
	setmemoryconfig(1,0,0);
	Common::TestInit();

	a.x := 10;
	a.y := 20;
	b.x := 0;
	b.y := 0;

	b := a;

	Vars::text := "2.67";
	if ((b.x = 10) and (b.y = 20)) then Common::PASS() else Common::FAIL();

	@addmonitorcommand "command 1  \"save \\\"$DIR/results.bin\\\" 0 8000 8000  ; quit \"  "
	addbreakpoint();
	moveto(5,24,04);
	if (peek(^$8000,0)=0) then
		printstring("PASS",0,40)
	else
		printstring("FAIL",0,40);
	loop();
end.
